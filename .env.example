POSTGRES_USER=cimarron
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=cimalert
POSTGRES_PORT=5432

DATABASE_URL=postgres://cimarron:cambia_esto@postgres:5432/cimalert?sslmode=disable
API_PORT=8080
JWT_SECRET=cambia_estocambia_estocambia_estocambia_estocambia_estocambia_esto

ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# OAuth client IDs de Google (web, Android, iOS) separados por ';', los que
# aceptamos como aud del ID token. Vacío apaga el inicio de sesión con Google.
GOOGLE_CLIENT_IDS=

VITE_API_URL=/api/v1
VITE_MAPLIBRE_STYLE_URL=

LOG_LEVEL=info
LOG_FORMAT=text

RECOVERY_SECRET=cambia_estocambia_estocambia_estocambia_estocambia_estocambia_esto
MAIL_DRIVER=log

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<login SMTP que muestra Brevo>
SMTP_PASS=<clave SMTP generada en Brevo>
MAIL_FROM=<remitente verificado en Brevo>

# Zona donde se permite crear reportes: puntos lat,lon separados por ';', al
# menos 3, en orden alrededor del borde (si los lados se cruzan, no arranca).
# Vacío usa el default: Baja California e islas.
REPORTE_POLIGONO=

# Publica /v1/docs y /v1/openapi.json. Déjalo en false en producción.
DOCS_ENABLED=true

# Cookie del refresh token del web. COOKIE_SECURE=false solo en local sin HTTPS;
# en producción déjalo en true (el default). COOKIE_PATH es la ruta que ve el
# navegador, con el /api que nginx quita (default /api/v1/auth).
COOKIE_SECURE=false

# Tope de memoria de cada contenedor (formato de Docker: 512m, 1g, ...).
BACKEND_MEM_LIMIT=8g
MULTIMEDIA_MEM_LIMIT=4g
