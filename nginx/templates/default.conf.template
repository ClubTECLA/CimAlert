# Plantilla: la imagen de nginx sustituye las variables de entorno definidas (aquí
# MEDIA_LINK_SECRET) y deja el resultado en /etc/nginx/conf.d/default.conf. El
# nginx.conf de la imagen ya incluye mime.types (sin él un .mp4 sale como text/plain
# y, con nosniff, el navegador no lo reproduce) y todo conf.d/*.conf.
server {
    listen 80;
    server_name _;

    # No publica la versión de nginx en las cabeceras ni en las páginas de error.
    server_tokens off;

    # Subida de fotos y videos: único endpoint con body grande. El resto de /api/
    # conserva el límite por defecto de 1 MB. 12m deja margen sobre el
    # video (8 MiB) más el multipart.
    location ~ ^/api/v1/reportes/[^/]+/multimedia$ {
        client_max_body_size 12m;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
    }

    location /api/ {
        proxy_pass http://backend:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
    }

    # Fotos y videos guardados por el servicio multimedia. Solo se sirven con un enlace
    # firmado por el backend (?md5=...&expires=...): sin firma o con una mala es 403, y con
    # el enlace vencido, 410. La firma es MD5("<expires><uri> <secreto>"), igual que en
    # backend/internal/enlace; no incluye la IP porque en celular cambia.
    location /multimedia/ {
        secure_link $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri ${MEDIA_LINK_SECRET}";
        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        alias /data/uploads/;
        autoindex off;
        # No sigue symlinks: aunque alguien plante uno en el volumen, no sirve archivos de fuera.
        disable_symlinks on;
        try_files $uri =404;
        # Solo el navegador de quien tiene el enlace lo guarda, y poco tiempo: un enlace
        # vencido no debe seguir sirviendo desde un caché compartido.
        add_header Cache-Control "private, max-age=300";
        add_header X-Content-Type-Options "nosniff" always;
        # Un archivo servido nunca debe ejecutar scripts ni mostrarse dentro de otra página.
        add_header Content-Security-Policy "default-src 'none'" always;
        add_header X-Frame-Options "DENY" always;
    }

    location / {
        proxy_pass http://frontend-web:80/;
        proxy_set_header Host $host;
    }
}
